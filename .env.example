# Скопируй в .env и заполни. .env в git не попадает, этот файл — попадает.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Почта. Пусто EMAIL_HOST — письма печатаются в терминал, заполнено — уходят по SMTP.
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# База данных — PostgreSQL. Базу создать руками (см. README), пароль вписать сюда.
DB_NAME=project_4
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
